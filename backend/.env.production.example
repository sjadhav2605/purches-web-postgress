# =============================================================================
# DDPL Procurement API - Render production environment (TEMPLATE)
# Copy these keys into Render > Service > Environment. NEVER commit real values.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# REQUIRED. Must be "production": enables strict CORS (no localhost fallback)
# and hides stack traces in API errors.
NODE_ENV=production

# OPTIONAL. Render injects PORT automatically - do not set it yourself.
# PORT=10000

# ---- Database (Neon PostgreSQL) ---------------------------------------------
# REQUIRED. Use the Neon *pooled* connection string (host contains "-pooler")
# and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# OPTIONAL. Max connections per instance (default 5). Keep low for Neon.
DB_CONNECTION_LIMIT=5

# OPTIONAL. Set to "false" ONLY for a non-SSL database. Never for Neon.
# DB_SSL=true

# ---- Auth & Signing secrets (server refuses to start if missing) ------------
# REQUIRED. Signs login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_hex_string

# OPTIONAL. JWT lifetime (default 7d).
JWT_EXPIRES_IN=7d

# REQUIRED. Separate secret used to sign public vendor quote / delivery links.
# Generate a different value from JWT_SECRET. Changing it invalidates old links.
QUOTE_SIGNATURE_SALT=replace_with_another_long_random_hex_string

# ---- CORS / Frontend --------------------------------------------------------
# REQUIRED in production. Exact Vercel origin, no trailing path.
# Only this origin is allowed by CORS. Also used in email/WhatsApp portal links.
CLIENT_URL=https://your-app.vercel.app

# ---- One-time seeding -------------------------------------------------------
# OPTIONAL. Set to "true" for the FIRST deploy only to seed the admin, sites,
# materials and DB indexes, then remove it (or set to false).
# RUN_SEED=true

# REQUIRED only when RUN_SEED=true. Initial password for admin@ddpl.com and the
# seeded director accounts. Use a strong value and change it after first login.
# ADMIN_DEFAULT_PASSWORD=replace_with_strong_password

# ---- File storage (Supabase Storage) ----------------------------------------
# REQUIRED in production. Render's disk is wiped on every deploy, so vendor KYC
# documents and challan attachments are uploaded to Supabase Storage instead.
# Create a PUBLIC bucket named "uploads" (Supabase > Storage > New bucket).
SUPABASE_URL=https://aivqgrrkmodxgxbobbtc.supabase.co
# service_role key (Supabase > Project Settings > API). SERVER-SIDE ONLY:
# never put it in the frontend or in any VITE_* variable.
SUPABASE_KEY=replace_with_supabase_service_role_key
# OPTIONAL. Bucket name (default "uploads").
# SUPABASE_BUCKET=uploads

# ---- Cache (Redis) ----------------------------------------------------------
# OPTIONAL. Set to "false" if you have no Redis; the app uses in-memory cache.
REDIS_ENABLED=false
# Only when REDIS_ENABLED is not "false" (e.g. Render Key Value / Upstash):
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ---- Email notifications (optional; skipped if SMTP_HOST/SMTP_USER unset) ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="DDPL Procurement Portal" <procurement@yourdomain.com>

# ---- WhatsApp notifications (optional) --------------------------------------
# Option A: Meta WhatsApp Cloud API
# WHATSAPP_API_TOKEN=your_meta_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Option B: Twilio (used when the Meta variables are not set)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
