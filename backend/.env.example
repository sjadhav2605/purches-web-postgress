NODE_ENV=development
PORT=5000

# PostgreSQL Connection Settings
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=ddpl_procurement
DB_PORT=5432
DB_CONNECTION_LIMIT=25

# Security & JWT
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each. On Render set them in Service > Environment.
# (If missing, the server still starts using a fallback derived from the DB credential,
#  but set real values in production.)
JWT_SECRET=replace_with_random_hex_string_1
JWT_EXPIRES_IN=7d

# Signs public vendor quote / delivery links. Changing it invalidates existing links.
QUOTE_SIGNATURE_SALT=replace_with_random_hex_string_2

# CORS Allowed Origin: exact frontend origin (comma-separate for several).
# Local: http://localhost:5173   Render/Netlify/Vercel: https://your-frontend.example.com
CLIENT_URL=http://localhost:5173
